# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ── 虚拟环境 ────────────────────────────────────────────────────────────────
.venv/
venv/
ENV/
WPy64-*/

# ── 模型权重与推理缓存（体积大，不入库；用 scripts/download_model.py 获取）────
model/*
!model/.gitkeep
!model/README.md

# ── 运行产物 ────────────────────────────────────────────────────────────────
data/uploads/*
!data/uploads/.gitkeep
data/checkpoints/*
!data/checkpoints/.gitkeep
data/*.db
data/*.db-shm
data/*.db-wal
data/*.db-journal
# 运行时库备份（*.bak-<时间戳>）：本地排查用，不入库
data/*.db.bak-*
# 缩略图 / 格式转换缓存（可随时重建）
data/cache/
outputs/*
!outputs/.gitkeep
logs/*
!logs/.gitkeep

# ── 测试 / 覆盖率 / 类型检查缓存 ────────────────────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
.hypothesis/
.benchmarks/

# ── 本地独享内容（不上远程）─────────────────────────────────────────────────
local/
# Qoder 本地审查产物（better-harness run 目录与证据）
.qoder/
docs/plans/
docs/reports/
docs/_devarchive/
backups/
*.local.*
.env
.wb_download_tmp.sh

# ── 编辑器 / 操作系统 ───────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ── 治理（§7.1 / §13.1）────────────────────────────────────────────────────
AGENTS.md

# ── 桌面壳（Tauri v2 / Rust）────────────────────────────────────────────────
desktop/node_modules/
desktop/src-tauri/target/
desktop/src-tauri/gen/
# 更新签名私钥：绝不入库（公钥 desktop/tauri.key.pub 入库，作为 conf pubkey 校验基准）
desktop/tauri.key
# 例外（有意纳入跟踪，勿改为 ignore）：desktop/src-tauri/permissions/autogenerated/*.toml
